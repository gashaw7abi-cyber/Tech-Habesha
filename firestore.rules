rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /custom_news/{documentId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == "gashaw7abi@gmail.com" || request.auth.token.email == "Gashaw7abi@gmail.com");
    }
    match /stats/{documentId} {
      allow read: if request.auth != null && (request.auth.token.email == "gashaw7abi@gmail.com" || request.auth.token.email == "Gashaw7abi@gmail.com");
      allow write: if true;
    }
  }
}
