{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "techhabesha.com.et"
        }
      ],
      "destination": "https://www.techhabesha.com.et/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/feed.xml", "destination": "/api/rss" },
    { "source": "/rss", "destination": "/api/rss" }
  ],
  "headers": [
    {
      "source": "/rss.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=1200" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=1200" }
      ]
    }
  ]
}
